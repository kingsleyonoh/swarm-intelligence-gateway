# =============================================================================
# Swarm Intelligence Gateway — Environment Variables
# =============================================================================
# Copy to .env and fill in real values.
# NEVER commit .env — only .env.example is committed.

# --- Database ---
DATABASE_URL=postgresql://user:pass@localhost:5432/swarm_gateway

# --- Redis ---
REDIS_URL=redis://localhost:6379
WORLDMONITOR_REDIS_URL=rediss://default:xxxxx@xxxxx.upstash.io:6379
WORLDMONITOR_REDIS_TOKEN=xxxxx
# Current WorldMonitor deployments publish an R2 object pointer to Redis.
# Set all three values when that pointer contract is enabled.
WORLDMONITOR_R2_ACCOUNT_ID=xxxxx
WORLDMONITOR_R2_BUCKET=xxxxx
WORLDMONITOR_R2_API_TOKEN=xxxxx
# Optional Cloudflare API base URL; defaults to the public v4 API.
WORLDMONITOR_R2_API_BASE_URL=https://api.cloudflare.com/client/v4

# --- MiroFish ---
MIROFISH_API_URL=http://localhost:5000
DEEPSEEK_API_KEY=xxxxx

# --- App Config ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
POLL_INTERVAL_MINUTES=60
DEFAULT_AGENT_COUNT=4096
DEFAULT_ROUND_COUNT=5
SELF_REGISTRATION_ENABLED=true
DATA_RETENTION_DAYS=90

# --- Ecosystem (feature-flagged) ---
NOTIFICATION_HUB_ENABLED=false
NOTIFICATION_HUB_URL=http://notifications:8000
NOTIFICATION_HUB_API_KEY=xxxxx
WEBHOOK_SECRET=xxxxx

# --- Sentry ---
SENTRY_DSN=xxxxx

# --- Demo Security ---
# Enable demo security protections (rate limits, usage caps).
# See CODING_STANDARDS.md § Public Demo Security.
DEMO_MODE=true

# --- WorldMonitor (local instance) ---
# WORLDMONITOR_REDIS_URL=redis://localhost:6381
# GROQ_API_KEY=gsk_xxxxx  (for WorldMonitor forecast seeder)
